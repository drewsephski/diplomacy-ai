{
  "name": "seven-powers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint . && .venv/bin/ruff check engine",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts && .venv/bin/python -m pytest engine -q",
    "setup:engine": "uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r engine/requirements.txt",
    "sample": "tsx scripts/sample.ts",
    "test:browser": "playwright test",
    "test:datc": ".venv/bin/python -m pytest .venv/lib/python3.12/site-packages/diplomacy/tests/test_datc.py -q"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.329",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  }
}
